+        return ctx->kv_self.v_trans;
+    }
+    LLAMA_API uint32_t llama_kv_cache_get_size(struct llama_context * ctx) {
+        return ctx->kv_self.size;
+    }
+    LLAMA_API uint32_t llama_model_n_head_kv(const struct llama_model * model, int il) {
+        return model->hparams.n_head_kv_arr[il];
+    }
+    LLAMA_API uint32_t llama_model_d_head(const struct llama_model * model) {
+        return model->hparams.n_embd_head_k;
+    }
+    LLAMA_API float llama_model_rope_freq_base(const struct llama_model * model) {
+        return model->hparams.rope_freq_base_train;
+    }
+    LLAMA_API float llama_model_rope_freq_scale(const struct llama_model * model) {
+        return model->hparams.rope_freq_scale_train;
+    }
+    LLAMA_API uint32_t llama_model_rope_scaling_type(const struct llama_model * model) {
+        return (uint32_t) model->hparams.rope_scaling_type_train;
+    }
+    LLAMA_API const char * llama_model_name(const struct llama_model * model) {
+        return model->name.c_str();
+    }
+    LLAMA_API float llama_context_yarn_ext_factor(const struct llama_context * ctx) {
+        return ctx->cparams.yarn_ext_factor;
+    }
+    LLAMA_API float llama_context_yarn_beta_fast(const struct llama_context * ctx) {
+        return ctx->cparams.yarn_beta_fast;
+    }
+    LLAMA_API float llama_context_yarn_beta_slow(const struct llama_context * ctx) {
+        return ctx->cparams.yarn_beta_slow;
+    }
+    LLAMA_API uint32_t llama_context_yarn_n_ctx_orig(const struct llama_context * ctx) {
+        return ctx->cparams.n_ctx_orig_yarn;
+    }
+    LLAMA_API void llama_tensor_set_async(struct llama_context * ctx, struct ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
+        ggml_backend_t backend = nullptr;
+        if (ctx && !ctx->backends.empty()) {
+            backend = ctx->backends[0];
+        }
+        if (backend && tensor->buffer) {
+            ggml_backend_tensor_set_async(backend, tensor, data, offset, size);
+        } else {
+            ggml_backend_tensor_set(tensor, data, offset, size);
+        }
+    }
+    LLAMA_API void llama_backend_sync(struct llama_context * ctx) {
+        ggml_backend_t backend = nullptr;
+        if (ctx && !ctx->backends.empty()) {
+            backend = ctx->backends[0];
+        }
+        if (backend) {
+            ggml_backend_synchronize(backend);
+        }
+    }
+    LLAMA_API void llama_kv_cache_set_cell(struct llama_context * ctx, uint32_t cell_idx, llama_pos pos, llama_seq_id seq_id) {
+        if (cell_idx < ctx->kv_self.cells.size()) {
+            bool was_empty = ctx->kv_self.cells[cell_idx].is_empty();
+            
+            ctx->kv_self.cells[cell_idx].pos = pos;
+            ctx->kv_self.cells[cell_idx].delta = 0;
+            ctx->kv_self.cells[cell_idx].seq_id.clear();
+            ctx->kv_self.cells[cell_idx].seq_id.insert(seq_id);
+            
+            bool is_empty = ctx->kv_self.cells[cell_idx].is_empty();
+            if (was_empty && !is_empty) {
+                ctx->kv_self.used++;
+            } else if (!was_empty && is_empty) {
+                ctx->kv_self.used--;
+            }
+        }
+    }
+
+    LLAMA_API bool llama_register_host_memory(void * buffer, size_t size) {
+#ifdef GGML_USE_CUDA
+        return ggml_backend_cuda_register_host_buffer(buffer, size);
+#else
+        (void) buffer;
+        (void) size;
+        return true;
+#endif
+    }
+
+    LLAMA_API void llama_unregister_host_memory(void * buffer) {
+#ifdef GGML_USE_CUDA
+        ggml_backend_cuda_unregister_host_buffer(buffer);
+#else
+        (void) buffer;
+#endif
+    }
+
+    LLAMA_API void llama_kv_cache_rope_shift_gpu(struct llama_context * ctx, int32_t p, int32_t seq_len, int32_t delta_pos) {
+        if (delta_pos == 0) return;
+        
+        std::vector<int32_t> old_deltas(ctx->kv_self.size);
+        for (uint32_t i = 0; i < ctx->kv_self.size; ++i) {
+            old_deltas[i] = ctx->kv_self.cells[i].delta;
+            ctx->kv_self.cells[i].delta = 0;
+        }
+        
+        for (int32_t i = 0; i < seq_len; ++i) {
+            uint32_t cell_idx = (p + i) % ctx->kv_self.size;
+            ctx->kv_self.cells[cell_idx].delta = delta_pos;
+        }
+        
+        ggml_backend_sched_reset(ctx->sched);
+        struct ggml_cgraph * gf = llama_build_graph_k_shift(*ctx);
+        ggml_backend_sched_alloc_graph(ctx->sched, gf);
+        llama_set_k_shift(*ctx);
+        llama_graph_compute(*ctx, gf, ctx->cparams.n_threads);
+        
+        for (uint32_t i = 0; i < ctx->kv_self.size; ++i) {
+            ctx->kv_self.cells[i].delta = old_deltas[i];
+        }
+    }
+
+    LLAMA_API bool llama_context_is_metal(struct llama_context * ctx) {
+        ggml_backend_t backend = nullptr;
+        if (ctx && !ctx->backends.empty()) {
+            backend = ctx->backends[0];
+        }
+        if (backend) {
+#ifdef GGML_USE_METAL
+            return ggml_backend_is_metal(backend);
+#endif
+        }
+        return false;
+    }
+
+    LLAMA_API bool llama_context_is_cuda(struct llama_context * ctx) {
+        ggml_backend_t backend = nullptr;
+        if (ctx && !ctx->backends.empty()) {
+            backend = ctx->backends[0];
+        }
+        if (backend) {
+#ifdef GGML_USE_CUDA
+            return ggml_backend_is_cuda(backend);
+#endif
+        }
+        return false;
+    }
+}
