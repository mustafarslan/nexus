+// Bridge functions for Project Nexus Offline KV Compiler
+extern "C" {
+    LLAMA_API struct ggml_tensor * llama_kv_cache_get_k(struct llama_context * ctx, int il) {
+        return ctx->kv_self.k_l[il];
+    }
+    LLAMA_API struct ggml_tensor * llama_kv_cache_get_v(struct llama_context * ctx, int il) {
+        return ctx->kv_self.v_l[il];
+    }
